# Copy this file to .env and fill in the values.
# Never commit the real .env file.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production behind HTTPS, e.g. https://payroll.example.com
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------- database
# Leave every database line empty to use a local SQLite file (db.sqlite3, or SQLITE_PATH).
#
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# Paste it here and put your database password in place of [YOUR-PASSWORD].
# (Use the Session pooler on port 5432, not the Transaction pooler on 6543.)
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Or give the parts separately instead of DATABASE_URL:
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# All Mehnatana tables are created inside this PostgreSQL schema (and every table
# name also starts with "mtn_"), so they never mix with other tables in the same
# Supabase project. The schema is created automatically on first connection.
POSTGRES_SCHEMA=mehnatana

# ---------------------------------------------------------------- support
SUPPORT_PHONE=+91 98765 43210
SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------- email (optional)
# If EMAIL_HOST is set, the "Forgot password" page also offers a reset link by email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-in

# ---------------------------------------------------------------- server (docker compose)
# The web address Caddy gets an HTTPS certificate for. Point the domain's DNS at the server first.
DOMAIN=payroll.example.com
# Behind Caddy the visitor's IP is taken from X-Forwarded-For (audit log).
TRUST_X_FORWARDED_FOR=True
